# 开发环境可使用 sqlite；正式部署必须用 PostgreSQL + RLS
DATABASE_URL=sqlite:///./crm_local.db
JWT_SECRET_KEY=development-only-secret-must-change-before-production
DEV_MODE=true
ALLOW_DEV_TENANT_REGISTRATION=true
APP_TIMEZONE=Asia/Shanghai
ACCESS_TOKEN_MINUTES=480
# 默认关闭外部模型：涉及客户隐私数据，请审批后启用私有/受控模型
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=
# 演示账号自定义（可选；.env 不入库，个人账号信息不进 git）
# DEMO_SALES_USER=sales01
# DEMO_ADMIN_USER=admin01
# DEMO_COLLEAGUE_USER=colleague01
# DEMO_PASSWORD=Demo@2026#Pass
